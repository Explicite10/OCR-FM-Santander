# ---------- Modelo de visión ----------
VLM_BACKEND=ollama
VLM_BASE_URL=http://localhost:11434
VLM_MODEL=qwen3-vl:8b-instruct
VLM_TIMEOUT_S=180
VLM_MAX_SIDE=1600
VLM_NUM_CTX=8192
# Qwen3.5 "piensa" por defecto; apagarlo: VLM_THINK=false
# VLM_THINK=false
VLM_LOCALIZADOR=true

# ---------- Documento ----------
RENDER_DPI=250
MAX_PAGES=6
MAX_PAGINAS_DOCUMENTO=30
SOLO_PDF=true
# Sin tarjeta INM reconocible -> código 220 (NO_ES_FORMA_MIGRATORIA)
RECHAZAR_NO_FM=true

# ---------- API ----------
MAX_CONCURRENT_JOBS=2
# POST /forma-migratoria y el historial exigen el header X-API-Key con este valor (401 si falta o no coincide).
# /health no la pide. Obligatoria en servidor (así está en srviatwo); generar una con: openssl rand -hex 32
API_KEY=cambia-esto
ENABLE_DOCS=true
# Historial (opcional): DATABASE_URL=postgresql+asyncpg://usuario:clave@host:5432/fm

# ---------- Docker (servidor) ----------
API_PORT=18475
# Compartir el Ollama de ine-ocr (misma GPU de 8 GB: un solo modelo cargado):
VLM_BASE_URL=http://ollama:11434
OLLAMA_NETWORK=ine-ocr_default
OLLAMA_NETWORK_EXTERNAL=true
OLLAMA_NUM_PARALLEL=1
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0
LOTE_DIR=./lote
